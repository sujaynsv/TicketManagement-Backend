<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ticket</groupId>
    <artifactId>ticket-management-system</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Ticket Management System</name>
    <description>Smart Ticket Issue Management System - Capstone Project</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.0</spring-cloud.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <sonar.exclusions>
            **/dto/**,
            **/entity/**,
            **/config/**,
            **/mapper/**,
            **/client/**,
            **/exception/**,
            **/security/**,
            **/listener/**
        </sonar.exclusions>

        <sonar.coverage.exclusions>
            **/dto/**/*,
            **/entity/**/*,
            **/config/**/*,
            **/mapper/**/*,
            **/client/**/*,
            **/exception/**/*,
            **/security/**/*,
            **/listener/**/*,
            **/scheduler/**/*,
            **/*Application.java
        </sonar.coverage.exclusions>

    </properties>

    <modules>
        <!-- Add modules as we create them -->
        <module>ticket-common</module>
        <module>eureka-server</module>
        <module>auth-service</module>
        <module>ticket-service</module>
        <module>assignment-service</module>
        <module>notification-service</module>
        <module>api-gateway</module>
        <module>config-server</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>
    <build>
    <plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>3.11.0</version>
            <configuration>
                <annotationProcessorPaths>
                    <path>
                        <groupId>org.projectlombok</groupId>
                        <artifactId>lombok</artifactId>
                        <version>1.18.32</version>
                    </path>
                </annotationProcessorPaths>
            </configuration>
        </plugin>

        <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.11</version>
            <configuration>
                <excludes>
            <exclude>com/ticket/security/**</exclude>
            <exclude>com/ticket/entity/**</exclude>
            
            <exclude>com/notification/dto/**</exclude>
            <exclude>com/notification/entity/**</exclude>
            <exclude>com/notification/config/**</exclude>
            <exclude>com/notification/client/**</exclude>
            <exclude>com/notification/listener/**</exclude>

            <exclude>com/assignment/scheduler/**</exclude>
            <exclude>com/assignment/listener/**</exclude>
            <exclude>com/assignment/client/**</exclude>
            <exclude>com/assignment/config/**</exclude>
            <exclude>com/assignment/exception/**</exclude>
            <exclude>com/ticket/listener/**</exclude>
            <exclude>com/ticket/client/**</exclude>
            <exclude>com/ticket/TicketServiceApplication</exclude>

            <exclude>**/dto/**</exclude>
            <exclude>**/mapper/**</exclude>
            <exclude>**/config/**</exclude>
        </excludes>
            </configuration>
            
             <executions>
                <execution>
                    <id>prepare-agent</id>
                    <goals>
                        <goal>prepare-agent</goal>
                    </goals>
                </execution>
                <execution>
                    <id>report</id>
                    <phase>test</phase> <goals>
                        <goal>report</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>
        <plugin>
            <groupId>org.sonarsource.scanner.maven</groupId>
            <artifactId>sonar-maven-plugin</artifactId>
            <version>3.10.0.2594</version>
        </plugin>
    </plugins>
</build>

</project>
